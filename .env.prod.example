
APP_ENV=prod

# PostgreSQL
POSTGRES_USER=b2b_commerce
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=b2b_commerce
DATABASE_URL=postgresql+asyncpg://b2b_commerce:CHANGE_ME@postgres:5432/b2b_commerce

REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=b2b_commerce
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=b2b_commerce
MINIO_SECURE=false

# TLS / reverse proxy
DOMAIN=b2b-commerce.example.com
ACME_EMAIL=admin@example.com

# Первый администратор
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME

# Cookie settings
SESSION_COOKIE=b2b_commerce_session
CSRF_COOKIE=b2b_commerce_csrf
SESSION_TTL_HOURS=12
INVOICE_TTL_BUSINESS_DAYS=2
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

FORWARDED_ALLOW_IPS=172.28.10.0/24,127.0.0.1,::1
ALLOWED_HOSTS=b2b-commerce.example.com,127.0.0.1

SUPPLIER_LEGAL_NAME='Demo Supplier LLC'
SUPPLIER_INN=7701234567
SUPPLIER_KPP=770101001
SUPPLIER_LEGAL_ADDRESS=г. Москва, ул. Примерная, д. 1
SUPPLIER_BANK_NAME='Demo Bank JSC'
SUPPLIER_BIK=044525974
SUPPLIER_BANK_ACCOUNT=40702810100000001234
SUPPLIER_CORR_ACCOUNT=30101810145250000974
